# This file is for the DEVELOPMENT CHECKOUT ONLY.
#
# PRODUCTION'S ENV FILE LIVES OUTSIDE THE REPOSITORY — by default
# /srv/doclifts/.env, overridable with DOCLIFTS_PROD_ENV. It is passed
# explicitly by scripts/compose-prod.sh and scripts/migrate-prod.sh, both of
# which use `docker compose --env-file`. Never symlink this checkout's `.env`
# to it: the checkout is the working copy for tests and tooling, and a symlink
# made every tool run here (vitest, drizzle-kit, tsx) read production
# credentials by default. That happened once; do not recreate it.
#
# Copy to `.env` and fill in the dev values. This file must NOT contain
# POSTGRES_PASSWORD — a bare `docker compose -p doclifts up` from the checkout
# should fail loudly on the missing variable rather than quietly reuse
# production's.

# --- development -----------------------------------------------------------
# Local/dev database used by the app at runtime. A throwaway credential is
# fine; the dev Postgres is disposable and never holds real data.
DATABASE_URL=postgresql://doclifts:dev-only@localhost:5432/doclifts

# Integration-test database used by src/lib/server/test-db.ts. Must end in
# _test — db/index.ts refuses to build a client under vitest against any other
# name.
TEST_DATABASE_URL=postgresql://doclifts:dev-only@localhost:5432/doclifts_test

# --- shared ----------------------------------------------------------------
# Canonical origin of the deployment. adapter-node infers Host per request,
# but Better Auth needs a stable baseURL: it derives the cookie domain, the
# Secure flag, and the /api/auth/* callback URLs from this. Set it to the
# EXACT origin users browse to, including scheme and port.
#   private tailnet instance: http://100.118.77.26:3000
#   local dev:                http://localhost:5173
#   a public deployment MUST be https://, or Secure cookies will not persist
#   and sign-in will appear to succeed then immediately bounce.
PUBLIC_ORIGIN=http://localhost:5173

# Signs session cookies and hashes passwords. REQUIRED — the app throws on
# first auth use without it. Generate with:
#   openssl rand -base64 32
# Never commit a real value, and never reuse the demo value in production.
BETTER_AUTH_SECRET=

# D2: leave unset to keep /signup closed. Accounts are then created only by
# `pnpm user:bootstrap` and `pnpm user:create`. Set to 1 to open public
# sign-up. This is a policy toggle, not an auth-off toggle — there is no
# auth-off mode.
# DOCLIFTS_OPEN_SIGNUP=1

# Rate-limit storage. Unset = in-memory (per process, fine for a single
# instance). Set to `database` when running more than one web instance, since
# in-memory counters are not shared between processes.
# DOCLIFTS_RATE_LIMIT_STORAGE=database
