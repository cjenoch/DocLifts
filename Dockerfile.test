FROM node:24.22.2-bookworm-slim AS node
# Keep this browser tag aligned with the lockfile and GitHub Actions.
FROM mcr.microsoft.com/playwright:v1.59.1-noble
COPY --from=node /usr/local/ /usr/local/
RUN corepack enable pnpm && corepack prepare pnpm@11.3.0 --activate \
    && test "$(node -p 'process.versions.node')" = 24.22.2
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /work
CMD ["sleep", "infinity"]
